{
  "name": "personalos-home",
  "private": true,
  "version": "4.0.0-beta.1",
  "description": "A native-first, mobile-friendly Obsidian workspace plugin",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && node esbuild.config.mjs",
    "test": "tsc -p tsconfig.tests.json && node --test build-test/tests/*.test.js",
    "check": "npm run test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "esbuild": "0.25.5",
    "obsidian": "latest",
    "typescript": "^5.8.3"
  }
}
